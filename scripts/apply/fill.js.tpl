// Generated by `hj fill-script`. Fills the basic fields of a job application in the CURRENT tab, reads each value
// back, and reports what still needs a person/agent (file uploads, LinkedIn/Google sync, unknown questions).
// It never clicks Submit. Run it with any tool that can execute JavaScript in the user's tab, or paste it into the
// DevTools console. The result is returned and also stored in window.__hjFill.
(async () => {
  __BLOCKS__;                    // marks generic question blocks (data-hj-block) on systems without known selectors
  const ANSWERS = __ANSWERS__;   // [{label, value?, file?, skip?}]
  const MODE = "__MODE__";       // "fill": set the basic fields; "verify": change nothing, only check the page
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const norm = (s) => (s || "").replace(/[✱*]/g, "").replace(/\s+/g, " ").trim().toLowerCase();
  const CONTAINERS = [
    "[class*=application-form-field-entry]",                   // Ashby
    "li.application-question",                                 // Lever
    ".select__container", ".phone-input__phone", ".field-wrapper", // Greenhouse
    "[data-hj-block]",                                         // generic fallback (blocks.js)
  ].join(",");

  const visible = (el) => !!el && el.getClientRects().length > 0;   // works for fixed/portal menus too
  function questionText(c) {
    if (c.hasAttribute("data-hj-block")) {                            // no reliable <label>: question = first text line
      return norm(c.innerText.split("\n").map(norm).find(Boolean) || "");   // skips lone "*" required markers
    }
    const f = c.querySelector("input[type=file][id]");               // Greenhouse: real label sits elsewhere
    const up = f && document.getElementById("upload-label-" + f.id);
    if (up && up.innerText.trim()) return norm(up.innerText.split("\n")[0]);
    const lab = c.querySelector("label, .application-label, [class*=question-title]");
    const t = (lab ? lab.innerText : c.innerText).split("\n")[0];
    return norm(t);
  }
  function containers() {
    const all = [...document.querySelectorAll(CONTAINERS)];
    // innermost containers only (a Greenhouse .field-wrapper can hold a .select__container)
    return all.filter((c) => !all.some((o) => o !== c && c.contains(o)) &&
      c.querySelector("input, textarea, select, button"));
  }
  function findContainer(label) {
    const want = norm(label);
    const cs = containers();
    return cs.find((c) => questionText(c) === want) ||
           cs.find((c) => questionText(c).startsWith(want.slice(0, 60)));
  }
  function setNative(el, v) {   // React/Vue-safe value set
    const proto = el instanceof HTMLTextAreaElement ? HTMLTextAreaElement.prototype : HTMLInputElement.prototype;
    Object.getOwnPropertyDescriptor(proto, "value").set.call(el, v);
    el.dispatchEvent(new Event("input", { bubbles: true }));
    el.dispatchEvent(new Event("change", { bubbles: true }));
  }
  function textInput(c) {
    return c.querySelector("input[type=tel]") || c.querySelector("input[type=email]") ||
      [...c.querySelectorAll("input[type=text], input:not([type])")].find(visible) ||
      c.querySelector("input:not([type=hidden]):not([type=file]):not([type=checkbox]):not([type=radio])");
  }
  async function pickOption(c, input, v) {
    const search = v.split(" +")[0];
    input.focus();
    const ctl = input.closest("[class*=control]") || input;      // react-select opens on mousedown on its control
    ctl.dispatchEvent(new MouseEvent("mousedown", { bubbles: true }));
    setNative(input, search);
    for (let i = 0; i < 15; i++) {
      await sleep(200);
      const opts = [...document.querySelectorAll("[role=option]")].filter(visible);
      const o = opts.find((o) => norm(o.innerText) === norm(v)) ||
                opts.find((o) => norm(o.innerText).includes(norm(search)));
      if (o) {
        ["mousedown", "mouseup", "click"].forEach((t) => o.dispatchEvent(new MouseEvent(t, { bubbles: true })));
        await sleep(150);
        return true;
      }
    }
    return false;
  }
  function shown(c, v) {
    // radio/checkbox sets: every option's text is always on the page, so only a CHECKED option with that label counts
    const pressable = [...c.querySelectorAll("button[aria-pressed]")];          // Ashby yes/no buttons
    if (pressable.length) return pressable.some((b) => b.getAttribute("aria-pressed") === "true" && norm(b.innerText) === norm(v));
    const choices = [...c.querySelectorAll("input[type=radio], input[type=checkbox]")];
    if (choices.length) {
      const lab = (i) => norm(i.labels && i.labels[0] ? i.labels[0].innerText : i.parentElement.innerText);
      return choices.some((i) => i.checked && (lab(i) === norm(v) || lab(i).startsWith(norm(v))));
    }
    // the answer must appear OUTSIDE the question's own text, as whole words ("No" must not match "now")
    const q = (c.querySelector("label, .application-label, [class*=question-title]") || {}).innerText || "";
    let body = c.innerText;
    if (q && body.startsWith(q)) body = body.slice(q.length);
    else body = body.split("\n").slice(1).join(" ");
    const t = " " + norm(body) + " " + [...c.querySelectorAll("input, textarea")].map((i) => norm(i.value)).join(" ") + " ";
    const has = (x) => {
      const n = norm(x);
      if (!n) return false;
      const esc = n.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      return new RegExp("(^|[^a-z0-9])" + esc + "($|[^a-z0-9])").test(t);
    };
    const [name, code] = v.split(" +");
    const digits = v.replace(/\D/g, "");          // phone: "(555) 010-0100" vs "5550100100"
    const phoneOk = digits.length >= 7 && [...c.querySelectorAll("input")].some((i) => (i.value || "").replace(/\D/g, "").endsWith(digits));
    return has(v) || has(name) || (code && t.includes("+" + code)) || phoneOk;
  }


  const same = (got, v) => {                     // tolerant compare: phone formatting, case, spacing
    const d = (x) => (x || "").replace(/\D/g, "");
    return norm(got) === norm(v) || (d(v).length >= 7 && d(got) === d(v)) || norm(got).includes(norm(v));
  };
  function requiredEmpty() {
    return containers().filter((c) => /[*✱]/.test((c.querySelector("label, .application-label") || c).innerText.split("\n")[0] || "")
      || c.querySelector("[required], [aria-required=true]"))
      .filter((c) => {
        const isFileQ = ANSWERS.some((a) => a.file && norm(a.label) === questionText(c));
        if (isFileQ) return !/\.(pdf|docx?)\b/i.test(c.innerText) && !/\.(pdf|docx?)\b/i.test(document.body.innerText)
                            && !(c.querySelector("input[type=file]")?.files?.length);
        const f = c.querySelector("input[type=file]");
        // after upload some boards replace the input with a file "chip" outside this block
        if (f) return !(f.files && f.files.length) && !/\.(pdf|docx?)\b/i.test(c.innerText) &&
                      !/\.(pdf|docx?)\b/i.test(document.body.innerText);
        const ins = [...c.querySelectorAll("input:not([type=hidden]):not([type=file]), textarea, select")];
        const chosen = c.querySelector("[class*=single-value], [class*=singleValue]");
        return !chosen && !ins.some((i) => (i.type === "checkbox" || i.type === "radio") ? i.checked : (i.value || "").trim());
      }).map(questionText);
  }

  const report = { mode: MODE, filled: [], needs_agent: [], skipped: [], unmatched_questions: [], required_empty: [],
                   verified: [], not_shown: [] };
  const used = new Set();
  if (MODE === "verify") {
    for (const a of ANSWERS) {
      if (a.skip) continue;
      const c = findContainer(a.label);
      if (!c) { report.not_shown.push({ label: a.label, reason: "question not on page" }); continue; }
      used.add(c);
      const ok = a.file ? ((c.querySelector("input[type=file]")?.files?.length) || /\.(pdf|docx?)\b/i.test(c.innerText)
                           || /\.(pdf|docx?)\b/i.test(document.body.innerText))
                        : shown(c, String(a.value ?? ""));
      (ok ? report.verified : report.not_shown).push(ok ? a.label : { label: a.label, reason: "value not visible" });
    }
  }
  let pending = MODE === "fill" ? [...ANSWERS] : [];
  for (let pass = 0; pass < 3 && pending.length; pass++) {   // later passes catch follow-up questions
  const retry = [];
  for (const a of pending) {
    if (a.skip) { report.skipped.push(a.label); continue; }
    const c = findContainer(a.label);
    if (!c) { if (pass < 2) retry.push(a); else report.needs_agent.push({ label: a.label, reason: "question not found on page" }); continue; }
    used.add(c);
    if (a.file) { report.needs_agent.push({ label: a.label, reason: "upload " + a.file + " (file dialog)" }); continue; }
    const v = String(a.value ?? "");
    if (v && shown(c, v) && !c.querySelector("textarea")) { report.filled.push(a.label); continue; }  // idempotent: leave correct fields alone
    let ok = false, how = "";
    try {
      const sel = c.querySelector("select");
      const combo = c.querySelector("[role=combobox], input[placeholder='Start typing...']");
      const ta = c.querySelector("textarea");
      const btn = [...c.querySelectorAll("button")].find((b) => norm(b.innerText) === norm(v));
      const radio = [...c.querySelectorAll("label")].find((l) => norm(l.innerText) === norm(v) && (l.control || l.querySelector("input[type=radio], input[type=checkbox]")));
      if (sel) {
        const o = [...sel.options].find((o) => norm(o.text) === norm(v)) || [...sel.options].find((o) => norm(o.text).includes(norm(v)));
        if (o) { sel.value = o.value; sel.dispatchEvent(new Event("change", { bubbles: true })); }
        ok = !!o && sel.value === o.value; how = "select";
      } else if (combo && !c.querySelector("input[type=tel]")) {
        // Custom dropdowns/autocompletes (React select widgets) ignore scripted events; they need real input.
        report.needs_agent.push({ label: a.label, kind: "dropdown", value: v,
          reason: `dropdown: click it, type ${JSON.stringify(v.split(" +")[0])}, choose ${JSON.stringify(v)}` });
        continue;
      } else if (ta) {
        setNative(ta, v); ok = same(ta.value, v); how = "textarea";
      } else if (btn) {
        btn.click(); await sleep(250); ok = btn.hasAttribute("aria-pressed") ? shown(c, v) : true; how = "choice";
      } else if (radio) {
        const rin = radio.control || radio.querySelector("input"); rin.click(); await sleep(400); ok = shown(c, v);   // React updates `checked` a tick later how = "radio";
      } else {
        const i = textInput(c);
        if (i) { i.focus(); setNative(i, v); await sleep(300); ok = same(i.value, v); }
        how = "text";
        if (!ok && i) {   // e.g. a location box that only accepts a picked suggestion
          report.needs_agent.push({ label: a.label, kind: "text", value: v,
            reason: `type ${JSON.stringify(v)} by hand and pick the matching suggestion if one appears` });
          continue;
        }
      }
    } catch (e) { how = "error: " + e.message; }
    (ok ? report.filled : report.needs_agent).push(ok ? a.label : { label: a.label, reason: `could not set (${how}); wanted ${JSON.stringify(v)}` });
    await sleep(100);
  }
  pending = retry;
  await sleep(400);
  }
  // follow-up questions that appeared after answers (e.g. race after Hispanic/Latino), and anything unanswered
  for (const c of containers()) {
    if (used.has(c)) continue;
    const q = questionText(c);
    if (q && !ANSWERS.some((a) => norm(a.label) === q)) report.unmatched_questions.push(q);
  }
  if (MODE === "fill") {        // re-check after the page settles: some boxes clear themselves (autocompletes)
    await sleep(1500);
    document.activeElement && document.activeElement.blur && document.activeElement.blur();
    await sleep(500);
    for (const label of [...report.filled]) {
      const a = ANSWERS.find((x) => x.label === label);
      const c = findContainer(label);
      if (a && c && !shown(c, String(a.value ?? ""))) {
        report.filled.splice(report.filled.indexOf(label), 1);
        report.needs_agent.push({ label, kind: "autocomplete", value: a.value,
          reason: `cleared itself: type ${JSON.stringify(a.value)} by hand and pick the matching suggestion` });
      }
    }
  }
  report.required_empty = requiredEmpty();
  report.ready = MODE === "verify"
    ? !report.not_shown.length && !report.required_empty.length && !report.unmatched_questions.length
    : null;
  window.__hjFill = report;
  return report;
})();
